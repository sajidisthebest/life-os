# Copy to .dev.vars for local `wrangler dev` (never commit real values).
# For production, use `wrangler secret put <NAME>` instead — never commit secrets.
SESSION_SECRET=SET_SESSION_SECRET_AT_LEAST_20_CHARS
APP_PASSWORD=SET_APP_PASSWORD_AT_LEAST_12_CHARS
AGENT_API_KEY=SET_AGENT_API_KEY_AT_LEAST_20_CHARS
MCP_API_KEY=SET_MCP_API_KEY_AT_LEAST_20_CHARS
PUBLIC_BASE_URL=http://localhost:8787
